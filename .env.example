# Copy to .env and fill in. .env is git-ignored.
# No credentials go in this file: the AWS profile points at ~/.aws, where the
# scoped lab user's keys live (see infra/bootstrap/README.md).

AWS_PROFILE=model-eval
AWS_REGION=us-east-1
# The harness refuses to run as anyone else (DECISIONS.md D-022).
LAB_IAM_USER=model-eval-lab

# In-region model IDs (DECISIONS.md D-012).
NOVA_MICRO_MODEL_ID=amazon.nova-micro-v1:0
NOVA_PRO_MODEL_ID=amazon.nova-pro-v1:0
