# --- Secrets & credentials ---------------------------------------------
# Bedrock/AWS credentials and any local config holding keys.
.env
.env.*
!.env.example
*.pem
*.key
.aws/
credentials
seed.json
*.local.json

# --- Terraform ----------------------------------------------------------
# State can contain secrets and resource IDs; keep it local (or in a remote backend).
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# NOTE: .terraform.lock.hcl is intentionally NOT ignored; commit it to pin provider versions.

# --- Experiment output --------------------------------------------------
# runs/ is TRACKED (D-104): raw per-run telemetry and manifests, the labeling sheets, and the
# filled skeleton fixtures, drafts and scratch files below. A manifest holds that run's flag,
# password and secret_key; they are random per run (secrets.token_urlsafe) and spent when the
# run ends, and the author accepted publishing them. The PyRIT memory DB (*.db, below) stays
# ignored. Curated, redacted results go in results/ and ARE committed.
# Log files stay ignored, except each run's own logs and the sqlmap stage-1 log.
*.log
!runs/**/*.log
!/stage1_sqlmap.log

# Databases anywhere: PyRIT memory, the target's SQLite file during local testing.
*.db
*.sqlite
*.sqlite3
*.duckdb
dbdata/

# Exported container images.
*.tar

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Claude Code --------------------------------------------------------
# Personal permission settings; shared agents in .claude/agents/ ARE committed.
.claude/settings.local.json

# --- OS / editor --------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
